import { Button, LineEdit, ScrollView, Slider, CheckBox, ComboBox } from "std-widgets.slint";

export struct InstanceItem {
    id: string,
    name: string,
    mc_version: string,
    mod_loader: string,
    last_played: string,
}

export struct AccountItem {
    id: string,
    username: string,
    account_type: string,
    last_login: string,
}

export struct ModItem {
    file_name: string,
    name: string,
    version: string,
    description: string,
    author: string,
    file_size: string,
    is_enabled: bool,
    icon: image,
    has_icon: bool,
    initial: string,
}

export struct OnlineModItem {
    project_id: string,
    title: string,
    description: string,
    author: string,
    downloads: string,
    slug: string,
    is_installed: bool,
    icon: image,
    has_icon: bool,
    initial: string,
}

export struct DownloadItem {
    file_name: string,
    status: string,
    size_text: string,
    is_done: bool,
}

export struct JavaItem {
    path: string,
    vendor: string,
    version: string,
    display_name: string,
}

export struct GpuItem {
    id: string,
    name: string,
    is_discrete: bool,
}

// Reusable Translucent Glass Card
component GlassCard inherits Rectangle {
    background: #ffffff0d;
    border-width: 1px;
    border-color: #ffffff1f;
    border-radius: 12px;
}

// Reusable Gamer Action Button
component ActionButton inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> is_primary: true;
    in-out property <bool> is_danger: false;
    in-out property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 8px;
    background: !root.enabled ? #25283666
        : (is_danger ? (touch.pressed ? #B91C1C : touch.has_hover ? #DC2626 : #EF4444)
        : (is_primary ? (touch.pressed ? #E62E3D : touch.has_hover ? #FF4D5E : #FF3344)
        : (touch.pressed ? #252836 : touch.has_hover ? #1F2230 : #151822)));
    border-width: !root.enabled ? 1px : (is_primary || is_danger ? 0px : 1px);
    border-color: !root.enabled ? #ffffff10 : #ffffff26;
    animate background { duration: 150ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }

    Text {
        text: root.text;
        font-weight: 700;
        font-size: 14px;
        color: !root.enabled ? #6B7280 : #FFFFFF;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Category Pill for Settings and Sub-views
component CategoryPill inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> is_active: false;
    callback clicked();

    height: 38px;
    border-radius: 8px;
    background: is_active ? #FF33442a : (touch.has_hover ? #ffffff0f : #ffffff08);
    border-width: 1px;
    border-color: is_active ? #FF334488 : #ffffff1a;
    animate background { duration: 150ms; }

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 700;
            color: root.is_active ? #FF4D5E : (touch.has_hover ? #FFFFFF : #A0A5B5);
            vertical-alignment: center;
        }
    }
}

// Reusable Nav Tab Item (Clean, Icon-Free, Bold Gamer Typography)
component NavTab inherits Rectangle {
    in-out property <string> icon: "";
    in-out property <string> label;
    in-out property <bool> is_active: false;
    callback clicked();

    height: 44px;
    border-radius: 8px;
    background: is_active ? #FF33442a : (touch.has_hover ? #ffffff0d : transparent);
    border-width: is_active ? 1px : 0px;
    border-color: #FF334488;
    animate background { duration: 120ms; }

    touch := TouchArea { clicked => { root.clicked(); } }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: start;
        Text {
            text: root.label;
            font-size: 15px;
            font-weight: is_active ? 800 : 600;
            color: is_active ? #FFFFFF : #A0A5B5;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "Digital Vigital (DV) — Minecraft Launcher";
    icon: @image-url("../assets/logo.png");
    preferred-width: 1240px;
    preferred-height: 820px;
    min-width: 1024px;
    min-height: 680px;
    background: #0B0C10;
    default-font-family: "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif";

    // Application State Properties
    // 0: Play, 1: Profiles, 2: Mods, 3: Downloads, 4: Accounts, 5: Settings, 6: Logs
    in-out property <int> active_tab: 0;
    in-out property <string> active_instance_name: "Fabric 1.21.4";
    in-out property <string> active_mc_version: "1.21.4";
    in-out property <string> active_mod_loader: "Fabric";
    in-out property <string> active_username: "DVPlayer";
    in-out property <string> active_account_type: "Offline Profile";
    in-out property <string> java_runtime_display: "OpenJDK 21 (Auto-Detected)";
    in-out property <string> game_status: "Ready to Play";
    in-out property <bool> is_running: false;
    in-out property <bool> is_downloading: false;

    // Download Queue
    in-out property <float> download_progress: 0.0;
    in-out property <string> download_status_text: "Idle";
    in-out property <string> download_bytes_text: "0 MB / 0 MB";
    in-out property <[DownloadItem]> download_history: [];
    in-out property <int> downloads_completed_count: 0;
    in-out property <int> downloads_total_count: 0;

    // Mods
    in-out property <[ModItem]> mod_list: [];
    in-out property <int> mods_count: 0;

    // Console Logs
    in-out property <string> console_output: "[DV Launcher] Client engine initialized.\n[DV Launcher] Ready to play.\n";

    // Settings
    in-out property <float> min_memory_mb: 1024;
    in-out property <float> max_memory_mb: 4096;
    in-out property <int> window_width: 1280;
    in-out property <int> window_height: 720;
    in-out property <bool> enable_discord_rpc: true;
    in-out property <string> custom_java_path: "";
    in-out property <string> launcher_root_dir_input: "";
    in-out property <string> profiles_dir_input: "";
    in-out property <string> selected_gpu_display: "Automatic (System Default)";
    in-out property <string> selected_gpu_id: "auto";
    in-out property <[GpuItem]> gpu_list: [];
    in-out property <[JavaItem]> java_list: [];

    // Profiles List & Creation
    in-out property <[InstanceItem]> instance_list: [];
    in-out property <string> new_instance_name: "Fabric 1.21.4";
    in-out property <string> new_instance_version: "1.21.4";
    in-out property <string> new_instance_loader: "Fabric";
    in-out property <[string]> version_list: [
        "1.21.4", "1.21.3", "1.21.2", "1.21.1", "1.21",
        "1.20.6", "1.20.5", "1.20.4", "1.20.3", "1.20.2", "1.20.1", "1.20",
        "1.19.4", "1.19.3", "1.19.2", "1.19.1", "1.19",
        "1.18.2", "1.18.1", "1.18",
        "1.17.1", "1.17",
        "1.16.5", "1.16.4", "1.16.3", "1.16.2", "1.16.1", "1.16",
        "1.15.2", "1.14.4", "1.13.2", "1.12.2", "1.11.2", "1.10.2",
        "1.9.4", "1.8.9", "1.7.10"
    ];
    in-out property <[string]> loader_list: ["Fabric", "Forge", "OptiFine", "Vanilla"];

    // Accounts
    in-out property <[AccountItem]> account_list: [];
    in-out property <string> offline_username_input: "DVPlayer";
    in-out property <string> auth_code_input: "";
    in-out property <string> auth_login_url: "";

    // Mods Management & Online Browser
    in-out property <int> mods_active_subtab: 0;
    in-out property <string> mod_search_query: "";
    in-out property <string> online_mod_search_query: "";
    in-out property <[OnlineModItem]> online_mod_list: [];
    in-out property <bool> is_searching_online_mods: false;
    in-out property <string> performance_preset: "aikar";
    in-out property <string> performance_preset_display: "Aikar's Flags (High FPS & Zero Stutter)";

    // Skin & Cape Customization
    in-out property <image> player_skin_image;
    in-out property <bool> has_player_skin: false;
    in-out property <image> player_cape_image;
    in-out property <bool> has_player_cape: false;
    in-out property <string> player_skin_name: "Classic (Steve)";
    in-out property <string> player_cape_name: "DV Crimson Cape";
    in-out property <bool> is_launching: false;
    in-out property <int> settings_tab_index: 0;
    in-out property <string> settings_save_status: "";

    // Rust Engine Callbacks
    callback play_clicked();
    callback install_clicked();
    callback repair_clicked();
    callback terminate_clicked();
    callback select_quick_version(string);
    callback select_active_version(string);
    callback select_active_loader(string);
    callback create_instance_clicked();
    callback delete_instance_clicked(string);
    callback select_instance_clicked(string);
    callback refresh_mods_clicked();
    callback open_mods_folder_clicked();
    callback toggle_mod_clicked(string);
    callback delete_mod_clicked(string);
    callback import_mod_file_clicked();
    callback search_online_mods_clicked(string);
    callback install_online_mod_clicked(string);
    callback filter_installed_mods(string);
    callback clear_downloads_history_clicked();
    callback open_cache_folder_clicked();
    callback add_offline_account_clicked();
    callback start_ms_auth_clicked();
    callback complete_ms_auth_clicked();
    callback logout_account_clicked(string);
    callback clear_console_clicked();
    callback save_settings_clicked();
    callback reset_settings_clicked();
    callback browse_java_clicked();
    callback select_java_runtime(string);
    callback browse_root_dir_clicked();
    callback browse_profiles_dir_clicked();
    callback open_root_dir_clicked();
    callback open_profiles_dir_clicked();
    callback select_gpu_preference(string, string);
    callback select_performance_preset(string);
    callback open_discord_clicked();
    callback open_website_clicked();
    callback change_skin_clicked();
    callback change_cape_clicked();
    callback reset_skin_clicked();
    callback reset_cape_clicked();
    callback select_cape_preset(string);

    HorizontalLayout {
        // ==========================================
        // LEFT SIDEBAR NAVIGATION
        // ==========================================
        Rectangle {
            width: 240px;
            background: #101218;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Brand Header
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 10px;
                        background: #FF334418;
                        border-width: 1px;
                        border-color: #FF334466;
                        clip: true;

                        Image {
                            source: @image-url("../assets/logo.png");
                            width: 100%;
                            height: 100%;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "DIGITAL VIGITAL";
                            font-size: 15px;
                            font-weight: 900;
                            color: #FFFFFF;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: "DV LAUNCHER";
                            font-size: 11px;
                            font-weight: 700;
                            color: #FF3344;
                            letter-spacing: 0.8px;
                        }
                    }
                }

                Rectangle { height: 1px; background: #ffffff14; }

                // Main Menu Section
                Text {
                    text: "MAIN MENU";
                    font-size: 11px;
                    font-weight: 800;
                    color: #8E92A4;
                    letter-spacing: 1.2px;
                }

                VerticalLayout {
                    spacing: 4px;

                    NavTab {
                        label: "Play";
                        is_active: root.active_tab == 0;
                        clicked => { root.active_tab = 0; }
                    }

                    NavTab {
                        label: "Profiles";
                        is_active: root.active_tab == 1;
                        clicked => { root.active_tab = 1; }
                    }

                    NavTab {
                        label: "Mods";
                        is_active: root.active_tab == 2;
                        clicked => {
                            root.active_tab = 2;
                            root.refresh_mods_clicked();
                        }
                    }

                    NavTab {
                        label: "Downloads";
                        is_active: root.active_tab == 3;
                        clicked => { root.active_tab = 3; }
                    }
                }

                Rectangle { height: 1px; background: #ffffff14; }

                // System & Utilities Section
                Text {
                    text: "UTILITIES & SYSTEM";
                    font-size: 11px;
                    font-weight: 800;
                    color: #8E92A4;
                    letter-spacing: 1.2px;
                }

                VerticalLayout {
                    spacing: 4px;

                    NavTab {
                        label: "Accounts";
                        is_active: root.active_tab == 4;
                        clicked => { root.active_tab = 4; }
                    }

                    NavTab {
                        label: "Settings";
                        is_active: root.active_tab == 5;
                        clicked => { root.active_tab = 5; }
                    }

                    NavTab {
                        label: "Game Logs";
                        is_active: root.active_tab == 6;
                        clicked => { root.active_tab = 6; }
                    }
                }

                // Push bottom switcher down
                Rectangle { vertical-stretch: 1; }

                // Community Links
                HorizontalLayout {
                    spacing: 8px;
                    height: 38px;

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: #ffffff0a;
                        border-width: 1px;
                        border-color: #5865F244;
                        TouchArea { clicked => { root.open_discord_clicked(); } }
                        HorizontalLayout {
                            alignment: center;
                            Text { text: "Discord"; font-size: 14px; font-weight: 700; color: #7289DA; vertical-alignment: center; }
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 8px;
                        background: #ffffff0a;
                        border-width: 1px;
                        border-color: #FF334444;
                        TouchArea { clicked => { root.open_website_clicked(); } }
                        HorizontalLayout {
                            alignment: center;
                            Text { text: "Website"; font-size: 14px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                        }
                    }
                }

                // Bottom Active Profile Switcher Card
                GlassCard {
                    height: 66px;
                    background: #ffffff08;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.active_instance_name;
                                font-size: 15px;
                                font-weight: 800;
                                color: #FFFFFF;
                                overflow: elide;
                            }
                            Text {
                                text: root.active_username + " • " + (root.is_running ? "Playing" : "Ready");
                                font-size: 13px;
                                font-weight: 600;
                                color: root.is_running ? #10B981 : #A0A5B5;
                            }
                        }

                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.is_running ? #10B981 : #6B7280;
                        }
                    }
                }
            }
        }

        // ==========================================
        // MAIN CONTENT AREA
        // ==========================================
        Rectangle {
            background: #0B0C10;
            horizontal-stretch: 1;

            // ------------------------------------------
            // TAB 0: PLAY (DASHBOARD)
            // ------------------------------------------
            if root.active_tab == 0 : VerticalLayout {
                padding: 24px;
                spacing: 20px;

                // Hero Banner
                GlassCard {
                    height: 230px;
                    background: #14161f88;

                    VerticalLayout {
                        padding: 24px;
                        alignment: space-between;

                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: "READY FOR ADVENTURE";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1.5px;
                                }
                                Text {
                                    text: root.active_instance_name;
                                    font-size: 32px;
                                    font-weight: 900;
                                    color: #FFFFFF;
                                }
                                Text {
                                    text: "Minecraft " + root.active_mc_version + " • " + root.active_mod_loader + " Mod Loader";
                                    font-size: 14px;
                                    color: #A0A5B5;
                                }
                            }

                            // Player Skin & Cape Character Showcase
                            HorizontalLayout {
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    width: 64px;
                                    height: 128px;
                                    border-radius: 8px;
                                    background: #ffffff0a;
                                    border-width: 1px;
                                    border-color: #ffffff18;
                                    clip: true;

                                    if root.has_player_skin : Image {
                                        source: root.player_skin_image;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }

                                    if !root.has_player_skin : Text {
                                        text: "👾";
                                        font-size: 32px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.has_player_cape : Rectangle {
                                    width: 44px;
                                    height: 70px;
                                    border-radius: 6px;
                                    background: #ffffff0a;
                                    border-width: 1px;
                                    border-color: #FF334466;
                                    clip: true;
                                    y: (parent.height - self.height) / 2;

                                    Image {
                                        source: root.player_cape_image;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: root.active_username;
                                        font-size: 15px;
                                        font-weight: 800;
                                        color: #FFFFFF;
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: #FF334426;
                                        border-width: 1px;
                                        border-color: #FF334466;
                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            Text {
                                                text: root.player_cape_name;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #FF4D5E;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    ActionButton {
                                        width: 110px;
                                        height: 28px;
                                        text: "Skin & Cape 🎨";
                                        is_primary: false;
                                        clicked => { root.active_tab = 4; }
                                    }
                                }
                            }

                            // Dynamic PLAY / DOWNLOADING / RUNNING Action Button
                            VerticalLayout {
                                spacing: 6px;
                                alignment: center;

                                ActionButton {
                                    width: 220px;
                                    height: 56px;
                                    text: root.is_running ? "⏹  STOP" :
                                          (root.is_downloading ? ("⏳ " + (root.download_progress > 0.0 ? Math.round(root.download_progress > 1.0 ? root.download_progress : root.download_progress * 100) + "%" : "DOWNLOADING...")) :
                                          (root.is_launching ? "🚀 LAUNCHING..." : "▶  PLAY"));
                                    is_danger: root.is_running;
                                    is_primary: !root.is_running && !root.is_downloading && !root.is_launching;
                                    enabled: root.is_running || (!root.is_downloading && !root.is_launching);
                                    clicked => {
                                        if (root.is_running) {
                                            root.terminate_clicked();
                                        } else if (!root.is_downloading && !root.is_launching) {
                                            root.play_clicked();
                                        }
                                    }
                                }

                                if root.is_downloading : Rectangle {
                                    width: 220px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #181B24;
                                    clip: true;

                                    Rectangle {
                                        x: 0px;
                                        width: Math.min(parent.width, Math.max(0px, parent.width * (root.download_progress > 1.0 ? (root.download_progress / 100.0) : root.download_progress)));
                                        height: parent.height;
                                        background: #FF3344;
                                        border-radius: 2px;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: #ffffff0d;
                                border-width: 1px;
                                border-color: #ffffff1f;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: root.is_running ? #10B981 : (root.is_downloading ? #FFB020 : (root.is_launching ? #3B82F6 : #10B981));
                                    }
                                    Text { text: root.game_status; font-size: 13px; font-weight: 600; color: #FFFFFF; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: #ffffff0d;
                                border-width: 1px;
                                border-color: #ffffff1f;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text { text: root.active_username; font-size: 13px; font-weight: 700; color: #FFFFFF; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                background: #ffffff0d;
                                border-width: 1px;
                                border-color: #ffffff1f;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text { text: root.java_runtime_display; font-size: 13px; font-weight: 600; color: #A0A5B5; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // Version & Mod Loader Selector
                GlassCard {
                    height: 168px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "VERSION & MOD LOADER SELECTOR";
                                font-size: 11px;
                                font-weight: 800;
                                color: #A0A5B5;
                                letter-spacing: 1px;
                            }
                            Text {
                                text: "Active: " + root.active_mc_version + " • " + root.active_mod_loader;
                                font-size: 11px;
                                font-weight: 700;
                                color: #FF3344;
                            }
                        }

                        // Dropdowns: All Minecraft Versions & Mod Loaders (Fabric, Forge, OptiFine, Vanilla)
                        HorizontalLayout {
                            spacing: 16px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Minecraft Version (Full Dropdown List)"; font-size: 11px; color: #A0A5B5; }
                                ComboBox {
                                    model: root.version_list;
                                    current_value: root.active_mc_version;
                                    selected(val) => { root.select_active_version(val); }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Mod Loader (Fabric, Forge, OptiFine, Vanilla)"; font-size: 11px; color: #A0A5B5; }
                                ComboBox {
                                    model: root.loader_list;
                                    current_value: root.active_mod_loader;
                                    selected(val) => { root.select_active_loader(val); }
                                }
                            }
                        }

                        // Quick Presets Row
                        HorizontalLayout {
                            spacing: 8px;

                            ActionButton {
                                text: "1.21.4 (Latest)";
                                is_primary: root.active_mc_version == "1.21.4";
                                clicked => { root.select_quick_version("1.21.4"); }
                            }

                            ActionButton {
                                text: "1.21.1 (Stable)";
                                is_primary: root.active_mc_version == "1.21.1";
                                clicked => { root.select_quick_version("1.21.1"); }
                            }

                            ActionButton {
                                text: "1.20.1 (Modpacks)";
                                is_primary: root.active_mc_version == "1.20.1";
                                clicked => { root.select_quick_version("1.20.1"); }
                            }

                            ActionButton {
                                text: "1.16.5 (Classic)";
                                is_primary: root.active_mc_version == "1.16.5";
                                clicked => { root.select_quick_version("1.16.5"); }
                            }

                            ActionButton {
                                text: "1.8.9 (PvP)";
                                is_primary: root.active_mc_version == "1.8.9";
                                clicked => { root.select_quick_version("1.8.9"); }
                            }
                        }
                    }
                }

                // Actions & Status Overview Grid
                HorizontalLayout {
                    spacing: 20px;
                    vertical-stretch: 1;

                    GlassCard {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            Text {
                                text: "PROFILE TOOLS";
                                font-size: 11px;
                                font-weight: 800;
                                color: #A0A5B5;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: "Keep your installation healthy and clean";
                                font-size: 13px;
                                color: #6B7280;
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                ActionButton {
                                    text: "Verify Files";
                                    is_primary: false;
                                    clicked => { root.install_clicked(); }
                                }

                                ActionButton {
                                    text: "Repair Assets";
                                    is_primary: false;
                                    clicked => { root.repair_clicked(); }
                                }

                                ActionButton {
                                    text: "View Active Mods";
                                    is_primary: false;
                                    clicked => {
                                        root.active_tab = 2;
                                        root.refresh_mods_clicked();
                                    }
                                }
                            }

                            Rectangle { vertical-stretch: 1; }
                        }
                    }

                    GlassCard {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            Text {
                                text: "SYSTEM STATUS";
                                font-size: 11px;
                                font-weight: 800;
                                color: #A0A5B5;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: "• GPU Mode: " + root.selected_gpu_display;
                                font-size: 13px;
                                color: #A0A5B5;
                            }

                            Text {
                                text: "• Allocated RAM: " + (root.max_memory_mb / 1024) + " GB";
                                font-size: 13px;
                                color: #A0A5B5;
                            }

                            Text {
                                text: "• Discord Rich Presence: " + (root.enable_discord_rpc ? "Enabled" : "Disabled");
                                font-size: 13px;
                                color: #A0A5B5;
                            }

                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 1: PROFILES (INSTANCES)
            // ------------------------------------------
            if root.active_tab == 1 : VerticalLayout {
                padding: 24px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Game Profiles";
                            font-size: 26px;
                            font-weight: 900;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Create and switch between separate Minecraft configurations, versions, and mod setups";
                            font-size: 13px;
                            color: #A0A5B5;
                        }
                    }
                }

                // New Profile Card
                GlassCard {
                    height: 120px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "NEW PROFILE";
                            font-size: 11px;
                            font-weight: 800;
                            color: #FF3344;
                            letter-spacing: 1px;
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: center;

                            VerticalLayout {
                                horizontal-stretch: 2;
                                spacing: 4px;
                                Text { text: "Profile Name"; font-size: 11px; color: #A0A5B5; }
                                LineEdit {
                                    text: root.new_instance_name;
                                    edited(val) => { root.new_instance_name = val; }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Minecraft Version"; font-size: 11px; color: #A0A5B5; }
                                ComboBox {
                                    model: root.version_list;
                                    current_value: root.new_instance_version;
                                    selected(val) => {
                                        root.new_instance_version = val;
                                        root.new_instance_name = root.new_instance_loader + " " + val;
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Mod Loader"; font-size: 11px; color: #A0A5B5; }
                                ComboBox {
                                    model: root.loader_list;
                                    current_value: root.new_instance_loader;
                                    selected(val) => {
                                        root.new_instance_loader = val;
                                        root.new_instance_name = val + " " + root.new_instance_version;
                                    }
                                }
                            }

                            ActionButton {
                                width: 140px;
                                text: "+ Create";
                                is_primary: true;
                                clicked => { root.create_instance_clicked(); }
                            }
                        }
                    }
                }

                // Profiles List
                GlassCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "INSTALLED PROFILES";
                            font-size: 11px;
                            font-weight: 800;
                            color: #A0A5B5;
                            letter-spacing: 1px;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;

                                for inst in root.instance_list : GlassCard {
                                    height: 58px;
                                    background: inst.name == root.active_instance_name ? #FF33441a : #ffffff08;
                                    border-color: inst.name == root.active_instance_name ? #FF334488 : #ffffff14;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 16px;
                                        alignment: center;

                                        Rectangle {
                                            width: 4px;
                                            height: 32px;
                                            border-radius: 2px;
                                            background: inst.name == root.active_instance_name ? #FF3344 : #ffffff24;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text {
                                                text: inst.name;
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: #FFFFFF;
                                            }
                                            Text {
                                                text: "Version: " + inst.mc_version + " • " + inst.mod_loader;
                                                font-size: 13px;
                                                color: #A0A5B5;
                                            }
                                        }

                                        ActionButton {
                                            width: 100px;
                                            height: 32px;
                                            text: inst.name == root.active_instance_name ? "Selected" : "Select";
                                            is_primary: inst.name == root.active_instance_name;
                                            clicked => { root.select_instance_clicked(inst.id); }
                                        }

                                        ActionButton {
                                            width: 80px;
                                            height: 32px;
                                            text: "Delete";
                                            is_danger: true;
                                            clicked => { root.delete_instance_clicked(inst.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 2: MODS
            // ------------------------------------------
            if root.active_tab == 2 : VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Mods & Addons";
                            font-size: 26px;
                            font-weight: 900;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Active Profile: " + root.active_instance_name + " • Loader: " + root.active_mod_loader + " " + root.active_mc_version;
                            font-size: 13px;
                            color: #A0A5B5;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        ActionButton {
                            width: 120px;
                            text: "Import .jar";
                            is_primary: true;
                            clicked => { root.import_mod_file_clicked(); }
                        }

                        ActionButton {
                            width: 120px;
                            text: "Open Folder";
                            is_primary: false;
                            clicked => { root.open_mods_folder_clicked(); }
                        }

                        ActionButton {
                            width: 90px;
                            text: "Refresh";
                            is_primary: false;
                            clicked => { root.refresh_mods_clicked(); }
                        }
                    }
                }

                // Sub-tabs switcher (Installed Mods vs Modrinth Online)
                HorizontalLayout {
                    spacing: 8px;
                    height: 40px;

                    Rectangle {
                        width: 160px;
                        border-radius: 8px;
                        background: root.mods_active_subtab == 0 ? #FF334426 : #ffffff0a;
                        border-width: 1px;
                        border-color: root.mods_active_subtab == 0 ? #FF334488 : #ffffff14;
                        TouchArea { clicked => { root.mods_active_subtab = 0; } }
                        Text {
                            text: "Installed Mods (" + root.mods_count + ")";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.mods_active_subtab == 0 ? #FFFFFF : #A0A5B5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 160px;
                        border-radius: 8px;
                        background: root.mods_active_subtab == 1 ? #FF334426 : #ffffff0a;
                        border-width: 1px;
                        border-color: root.mods_active_subtab == 1 ? #FF334488 : #ffffff14;
                        TouchArea {
                            clicked => {
                                root.mods_active_subtab = 1;
                                if root.online_mod_list.length == 0 {
                                    root.search_online_mods_clicked("");
                                }
                            }
                        }
                        Text {
                            text: "Get More Mods";
                            font-size: 14px;
                            font-weight: 700;
                            color: root.mods_active_subtab == 1 ? #FFFFFF : #A0A5B5;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                // SUBTAB 0: INSTALLED MODS
                if root.mods_active_subtab == 0 : GlassCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Search and filter bar
                        HorizontalLayout {
                            spacing: 12px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Search installed mods by title or file name...";
                                text: root.mod_search_query;
                                edited(val) => {
                                    root.mod_search_query = val;
                                    root.filter_installed_mods(val);
                                }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;

                                for mod in root.mod_list : GlassCard {
                                    height: 74px;
                                    background: mod.is_enabled ? #ffffff0d : #101218;
                                    border-color: mod.is_enabled ? #ffffff1f : #252836;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 16px;
                                        alignment: start;

                                        // Mod Logo / Icon
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: 10px;
                                            background: #ffffff0a;
                                            border-width: 1px;
                                            border-color: mod.is_enabled ? #ffffff1f : #ffffff0a;
                                            clip: true;

                                            if mod.has_icon : Image {
                                                source: mod.icon;
                                                width: 100%;
                                                height: 100%;
                                            }

                                            if !mod.has_icon : Rectangle {
                                                background: mod.is_enabled ? #FF33441a : #ffffff08;
                                                Text {
                                                    text: mod.initial;
                                                    font-size: 20px;
                                                    font-weight: 900;
                                                    color: mod.is_enabled ? #FF3344 : #6B7280;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Mod Details (Left-aligned)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            alignment: center;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Text {
                                                    text: mod.name;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    color: mod.is_enabled ? #FFFFFF : #6B7280;
                                                    horizontal-alignment: left;
                                                }

                                                if mod.version != "" : Rectangle {
                                                    border-radius: 4px;
                                                    background: #FF33441c;
                                                    border-width: 1px;
                                                    border-color: #FF334444;
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        padding-top: 2px;
                                                        padding-bottom: 2px;
                                                        Text {
                                                            text: "v" + mod.version;
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: #FF3344;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }

                                                if mod.author != "" : Text {
                                                    text: "by " + mod.author;
                                                    font-size: 12px;
                                                    color: #8E92A4;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                }
                                            }

                                            if mod.description != "" : Text {
                                                text: mod.description;
                                                font-size: 12px;
                                                color: #A0A5B5;
                                                overflow: elide;
                                                horizontal-alignment: left;
                                            }

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Rectangle {
                                                    width: 7px;
                                                    height: 7px;
                                                    border-radius: 3.5px;
                                                    background: mod.is_enabled ? #10B981 : #6B7280;
                                                    y: 4px;
                                                }

                                                Text {
                                                    text: (mod.is_enabled ? "Enabled" : "Disabled") + " • " + mod.file_name + " • " + mod.file_size;
                                                    font-size: 11px;
                                                    color: #6B7280;
                                                    horizontal-alignment: left;
                                                }
                                            }
                                        }

                                        // Actions
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: center;

                                            ActionButton {
                                                width: 95px;
                                                height: 34px;
                                                text: mod.is_enabled ? "Enabled" : "Disabled";
                                                is_primary: mod.is_enabled;
                                                clicked => { root.toggle_mod_clicked(mod.file_name); }
                                            }

                                            ActionButton {
                                                width: 80px;
                                                height: 34px;
                                                text: "Remove";
                                                is_danger: true;
                                                clicked => { root.delete_mod_clicked(mod.file_name); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // SUBTAB 1: GET MORE MODS (MODRINTH DISCOVERY)
                if root.mods_active_subtab == 1 : GlassCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Online Search bar
                        HorizontalLayout {
                            spacing: 12px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Search Modrinth mods (e.g. Sodium, Iris, Lithium, Fabric API)...";
                                text: root.online_mod_search_query;
                                edited(val) => { root.online_mod_search_query = val; }
                                accepted => { root.search_online_mods_clicked(root.online_mod_search_query); }
                            }

                            ActionButton {
                                width: 110px;
                                text: root.is_searching_online_mods ? "Searching..." : "Search";
                                is_primary: true;
                                clicked => { root.search_online_mods_clicked(root.online_mod_search_query); }
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;

                                for om in root.online_mod_list : GlassCard {
                                    height: 74px;
                                    background: #ffffff0a;
                                    border-color: #ffffff18;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 16px;
                                        alignment: start;

                                        // Mod Logo / Icon
                                        Rectangle {
                                            width: 48px;
                                            height: 48px;
                                            border-radius: 10px;
                                            background: #ffffff0a;
                                            border-width: 1px;
                                            border-color: #ffffff1f;
                                            clip: true;

                                            if om.has_icon : Image {
                                                source: om.icon;
                                                width: 100%;
                                                height: 100%;
                                            }

                                            if !om.has_icon : Rectangle {
                                                background: #FF33441a;
                                                Text {
                                                    text: om.initial;
                                                    font-size: 20px;
                                                    font-weight: 900;
                                                    color: #FF3344;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Mod Details (Left-aligned)
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            alignment: center;

                                            HorizontalLayout {
                                                spacing: 8px;
                                                alignment: start;

                                                Text {
                                                    text: om.title;
                                                    font-size: 15px;
                                                    font-weight: 700;
                                                    color: #FFFFFF;
                                                    horizontal-alignment: left;
                                                }

                                                if om.author != "" : Text {
                                                    text: "by " + om.author;
                                                    font-size: 12px;
                                                    color: #8E92A4;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                }

                                                Rectangle {
                                                    border-radius: 4px;
                                                    background: #ffffff0d;
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        padding-top: 2px;
                                                        padding-bottom: 2px;
                                                        Text {
                                                            text: om.downloads + " downloads";
                                                            font-size: 11px;
                                                            color: #A0A5B5;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            Text {
                                                text: om.description;
                                                font-size: 12px;
                                                color: #A0A5B5;
                                                overflow: elide;
                                                horizontal-alignment: left;
                                            }
                                        }

                                        // Actions
                                        HorizontalLayout {
                                            alignment: center;

                                            ActionButton {
                                                width: 105px;
                                                height: 34px;
                                                text: om.is_installed ? "Installed" : "Install";
                                                is_primary: !om.is_installed;
                                                clicked => {
                                                    if !om.is_installed {
                                                        root.install_online_mod_clicked(om.slug);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 3: DOWNLOADS
            // ------------------------------------------
            if root.active_tab == 3 : VerticalLayout {
                padding: 24px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Downloads";
                            font-size: 26px;
                            font-weight: 900;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Live download transfers, assets cache, and component history";
                            font-size: 13px;
                            color: #A0A5B5;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        ActionButton {
                            width: 130px;
                            text: "Cache Folder";
                            is_primary: false;
                            clicked => { root.open_cache_folder_clicked(); }
                        }

                        ActionButton {
                            width: 110px;
                            text: "Clear Log";
                            is_primary: false;
                            clicked => { root.clear_downloads_history_clicked(); }
                        }
                    }
                }

                // Progress Glass Card
                GlassCard {
                    height: 100px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: root.download_status_text;
                                font-size: 14px;
                                font-weight: 700;
                                color: #FFFFFF;
                                horizontal-alignment: left;
                            }
                            Text {
                                text: root.download_bytes_text;
                                font-size: 13px;
                                color: #A0A5B5;
                                horizontal-alignment: right;
                            }
                        }

                        // Crimson Progress Bar
                        Rectangle {
                            height: 8px;
                            border-radius: 4px;
                            background: #181B24;
                            clip: true;

                            Rectangle {
                                x: 0px;
                                width: Math.min(parent.width, Math.max(0px, parent.width * (root.download_progress > 1.0 ? (root.download_progress / 100.0) : root.download_progress)));
                                height: parent.height;
                                border-radius: 4px;
                                background: #FF3344;
                            }
                        }
                    }
                }

                // Download Queue List
                GlassCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: "TRANSFER QUEUE (" + root.downloads_completed_count + " / " + root.downloads_total_count + ")";
                            font-size: 11px;
                            font-weight: 800;
                            color: #A0A5B5;
                            letter-spacing: 1px;
                            horizontal-alignment: left;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;

                                for item in root.download_history : GlassCard {
                                    height: 48px;
                                    background: #ffffff08;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 16px;
                                        alignment: start;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: item.is_done ? #10B981 : #FFB020;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: item.file_name;
                                            font-size: 14px;
                                            font-weight: 600;
                                            color: #FFFFFF;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item.size_text;
                                            font-size: 13px;
                                            color: #A0A5B5;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: item.status;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.is_done ? #10B981 : #FF3344;
                                            horizontal-alignment: left;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 4: ACCOUNTS
            // ------------------------------------------
            if root.active_tab == 4 : VerticalLayout {
                padding: 24px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Accounts & Appearance";
                            font-size: 26px;
                            font-weight: 900;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Manage player accounts, custom skins, and cosmetic capes";
                            font-size: 13px;
                            color: #A0A5B5;
                        }
                    }
                }

                // ------------------------------------------
                // PLAYER APPEARANCE: SKIN & CAPE STUDIO
                // ------------------------------------------
                GlassCard {
                    height: 200px;
                    background: #14161f88;

                    HorizontalLayout {
                        padding: 20px;
                        spacing: 24px;
                        alignment: space-between;

                        // Left: Character & Cape Visual Showcase
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;

                            // Skin Model Box
                            Rectangle {
                                width: 80px;
                                height: 160px;
                                border-radius: 8px;
                                background: #ffffff0d;
                                border-width: 1px;
                                border-color: #ffffff26;
                                clip: true;

                                if root.has_player_skin : Image {
                                    source: root.player_skin_image;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                                if !root.has_player_skin : Text {
                                    text: "👾";
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Cape Model Box
                            Rectangle {
                                width: 50px;
                                height: 80px;
                                border-radius: 8px;
                                background: #ffffff0d;
                                border-width: 1px;
                                border-color: #FF334466;
                                clip: true;
                                y: (parent.height - self.height) / 2;

                                if root.has_player_cape : Image {
                                    source: root.player_cape_image;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                                if !root.has_player_cape : Text {
                                    text: "No\nCape";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #A0A5B5;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: "PLAYER APPEARANCE & GEAR";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: root.active_username;
                                    font-size: 20px;
                                    font-weight: 900;
                                    color: #FFFFFF;
                                }

                                Text {
                                    text: "Skin: " + root.player_skin_name;
                                    font-size: 13px;
                                    color: #A0A5B5;
                                }

                                Text {
                                    text: "Cape: " + root.player_cape_name;
                                    font-size: 13px;
                                    color: #A0A5B5;
                                }
                            }
                        }

                        // Right: Actions (Change Skin, Change Cape, Presets)
                        VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            width: 320px;

                            Text {
                                text: "CUSTOMIZE TEXTURES";
                                font-size: 11px;
                                font-weight: 800;
                                color: #A0A5B5;
                                letter-spacing: 1px;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton {
                                    text: "📁 Change Skin (.png)";
                                    is_primary: true;
                                    clicked => { root.change_skin_clicked(); }
                                }
                                ActionButton {
                                    width: 100px;
                                    text: "Reset Skin";
                                    is_primary: false;
                                    clicked => { root.reset_skin_clicked(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton {
                                    text: "🧣 Change Cape (.png)";
                                    is_primary: false;
                                    clicked => { root.change_cape_clicked(); }
                                }
                                ActionButton {
                                    width: 100px;
                                    text: "DV Cape";
                                    is_primary: false;
                                    clicked => { root.select_cape_preset("crimson"); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 20px;

                    // Offline Player Card
                    GlassCard {
                        horizontal-stretch: 1;
                        height: 180px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;

                            Text {
                                text: "OFFLINE ACCOUNT";
                                font-size: 11px;
                                font-weight: 800;
                                color: #FF3344;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: "Choose a custom player username for singleplayer or LAN servers:";
                                font-size: 12px;
                                color: #A0A5B5;
                            }

                            LineEdit {
                                text: root.offline_username_input;
                                edited(val) => { root.offline_username_input = val; }
                            }

                            ActionButton {
                                text: "+ Add Offline Player";
                                is_primary: true;
                                clicked => { root.add_offline_account_clicked(); }
                            }
                        }
                    }

                    // Microsoft Login Card
                    GlassCard {
                        horizontal-stretch: 1;
                        height: 180px;

                        VerticalLayout {
                            padding: 20px;
                            spacing: 10px;

                            Text {
                                text: "MICROSOFT ACCOUNT";
                                font-size: 11px;
                                font-weight: 800;
                                color: #FF3344;
                                letter-spacing: 1px;
                            }

                            Text {
                                text: "Log in with your official Microsoft account to join multiplayer servers:";
                                font-size: 12px;
                                color: #A0A5B5;
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: "Paste auth code here...";
                                    text: root.auth_code_input;
                                    edited(val) => { root.auth_code_input = val; }
                                }
                                ActionButton {
                                    width: 100px;
                                    text: "Confirm";
                                    is_primary: true;
                                    clicked => { root.complete_ms_auth_clicked(); }
                                }
                            }

                            ActionButton {
                                text: "Open Microsoft Login Page";
                                is_primary: false;
                                clicked => { root.start_ms_auth_clicked(); }
                            }
                        }
                    }
                }

                // Accounts List Card
                GlassCard {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        Text {
                            text: "STORED ACCOUNTS";
                            font-size: 11px;
                            font-weight: 800;
                            color: #A0A5B5;
                            letter-spacing: 1px;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 8px;

                                for acc in root.account_list : GlassCard {
                                    height: 52px;
                                    background: acc.username == root.active_username ? #FF33441a : #ffffff08;
                                    border-color: acc.username == root.active_username ? #FF334488 : #ffffff14;

                                    HorizontalLayout {
                                        padding: 12px;
                                        spacing: 14px;
                                        alignment: center;

                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            border-radius: 4px;
                                            background: acc.username == root.active_username ? #FF3344 : #ffffff26;
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            Text {
                                                text: acc.username;
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: #FFFFFF;
                                            }
                                            Text {
                                                text: acc.account_type + " • Last active: " + acc.last_login;
                                                font-size: 12px;
                                                color: #A0A5B5;
                                            }
                                        }

                                        ActionButton {
                                            width: 80px;
                                            height: 32px;
                                            text: "Logout";
                                            is_danger: true;
                                            clicked => { root.logout_account_clicked(acc.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 5: SETTINGS
            // ------------------------------------------
            if root.active_tab == 5 : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;

                    // Header with Title and Global Actions
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Launcher Settings";
                                font-size: 26px;
                                font-weight: 900;
                                color: #FFFFFF;
                            }
                            Text {
                                text: "Configure memory limits, Java runtimes, graphics adapter, and custom storage directories";
                                font-size: 13px;
                                color: #A0A5B5;
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;

                            if root.settings_save_status != "" : Text {
                                text: root.settings_save_status;
                                font-size: 13px;
                                font-weight: 700;
                                color: #10B981;
                                vertical-alignment: center;
                            }

                            ActionButton {
                                width: 140px;
                                height: 40px;
                                text: "↺ Reset Defaults";
                                is_primary: false;
                                clicked => { root.reset_settings_clicked(); }
                            }

                            ActionButton {
                                width: 140px;
                                height: 40px;
                                text: "💾 Save Settings";
                                is_primary: true;
                                clicked => { root.save_settings_clicked(); }
                            }
                        }
                    }

                    // Settings Sub-Category Navigation Bar
                    HorizontalLayout {
                        spacing: 8px;
                        CategoryPill {
                            text: "⚡ Java & Memory";
                            is_active: root.settings_tab_index == 0;
                            clicked => { root.settings_tab_index = 0; }
                        }
                        CategoryPill {
                            text: "🖥️ Graphics & GPU";
                            is_active: root.settings_tab_index == 1;
                            clicked => { root.settings_tab_index = 1; }
                        }
                        CategoryPill {
                            text: "🎮 Window & General";
                            is_active: root.settings_tab_index == 2;
                            clicked => { root.settings_tab_index = 2; }
                        }
                        CategoryPill {
                            text: "📁 Folders & Storage";
                            is_active: root.settings_tab_index == 3;
                            clicked => { root.settings_tab_index = 3; }
                        }
                    }

                    // ----------------------------------------------------
                    // SUB-TAB 0: JAVA & MEMORY
                    // ----------------------------------------------------
                    if root.settings_tab_index == 0 : VerticalLayout {
                        spacing: 16px;

                        // Memory & RAM Allocation
                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 16px;

                                Text {
                                    text: "MEMORY & RAM ALLOCATION";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "Select how much system memory to allocate for Minecraft. Modded versions generally need 4 GB to 8 GB.";
                                    font-size: 12px;
                                    color: #A0A5B5;
                                }

                                // Quick RAM Presets
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Quick Presets:";
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }

                                    ActionButton { width: 72px; height: 32px; text: "2 GB"; is_primary: root.max_memory_mb == 2048; clicked => { root.max_memory_mb = 2048; root.min_memory_mb = 1024; } }
                                    ActionButton { width: 72px; height: 32px; text: "4 GB"; is_primary: root.max_memory_mb == 4096; clicked => { root.max_memory_mb = 4096; root.min_memory_mb = 1024; } }
                                    ActionButton { width: 72px; height: 32px; text: "6 GB"; is_primary: root.max_memory_mb == 6144; clicked => { root.max_memory_mb = 6144; root.min_memory_mb = 2048; } }
                                    ActionButton { width: 72px; height: 32px; text: "8 GB"; is_primary: root.max_memory_mb == 8192; clicked => { root.max_memory_mb = 8192; root.min_memory_mb = 2048; } }
                                    ActionButton { width: 72px; height: 32px; text: "12 GB"; is_primary: root.max_memory_mb == 12288; clicked => { root.max_memory_mb = 12288; root.min_memory_mb = 4096; } }
                                    ActionButton { width: 72px; height: 32px; text: "16 GB"; is_primary: root.max_memory_mb == 16384; clicked => { root.max_memory_mb = 16384; root.min_memory_mb = 4096; } }
                                }

                                HorizontalLayout {
                                    spacing: 24px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text {
                                            text: "Maximum Allocated RAM (-Xmx): " + Math.round(root.max_memory_mb) + " MB (" + Math.round(root.max_memory_mb / 1024) + " GB)";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: #FFFFFF;
                                        }
                                        Slider {
                                            minimum: 1024;
                                            maximum: 16384;
                                            value: root.max_memory_mb;
                                            changed(val) => { root.max_memory_mb = val; }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text {
                                            text: "Minimum Allocated RAM (-Xms): " + Math.round(root.min_memory_mb) + " MB";
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: #FFFFFF;
                                        }
                                        Slider {
                                            minimum: 512;
                                            maximum: 8192;
                                            value: root.min_memory_mb;
                                            changed(val) => { root.min_memory_mb = val; }
                                        }
                                    }
                                }

                                // Garbage Collector & Performance Optimization
                                VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: "Garbage Collector & Performance Optimization Flags:";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #FFFFFF;
                                    }
                                    ComboBox {
                                        model: [
                                            "Aikar's Flags (High FPS & Zero Stutter)",
                                            "Shenandoah GC (Ultra-Low Latency)",
                                            "Generational ZGC (Java 21+ Modern)",
                                            "Vanilla / Default JVM"
                                        ];
                                        current_value: root.performance_preset_display;
                                        selected(val) => {
                                            root.select_performance_preset(val);
                                        }
                                    }
                                }
                            }
                        }

                        // Java Runtime Selection
                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: "JAVA RUNTIME SELECTION";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #FF3344;
                                            letter-spacing: 1px;
                                        }
                                        Text {
                                            text: "Active Java: " + root.java_runtime_display;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: #FFFFFF;
                                        }
                                    }

                                    ActionButton {
                                        width: 140px;
                                        height: 34px;
                                        text: "📁 Browse Java...";
                                        is_primary: false;
                                        clicked => { root.browse_java_clicked(); }
                                    }
                                }

                                // Detected Javas list
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Detected System Java Runtimes:";
                                        font-size: 12px;
                                        color: #A0A5B5;
                                    }

                                    for j in root.java_list : Rectangle {
                                        height: 42px;
                                        border-radius: 6px;
                                        background: j.path == root.custom_java_path ? #FF33441f : #ffffff08;
                                        border-width: 1px;
                                        border-color: j.path == root.custom_java_path ? #FF334488 : #ffffff14;

                                        TouchArea { clicked => { root.select_java_runtime(j.path); } }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 10px;
                                                Text { text: j.display_name; font-size: 13px; font-weight: 600; color: #FFFFFF; vertical-alignment: center; }
                                            }

                                            Text {
                                                text: j.path;
                                                font-size: 12px;
                                                color: #6B7280;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ----------------------------------------------------
                    // SUB-TAB 1: GRAPHICS & GPU
                    // ----------------------------------------------------
                    if root.settings_tab_index == 1 : VerticalLayout {
                        spacing: 16px;

                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                Text {
                                    text: "GRAPHICS & HARDWARE ACCELERATION (GPU)";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "Selected GPU Preference: " + root.selected_gpu_display;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: #FFFFFF;
                                }

                                Text {
                                    text: "Choose which GPU Minecraft should prioritize. For laptops with hybrid graphics (NVIDIA Optimus / AMD Prime), selecting your Discrete GPU ensures maximum FPS.";
                                    font-size: 12px;
                                    color: #A0A5B5;
                                }

                                VerticalLayout {
                                    spacing: 8px;

                                    for gpu in root.gpu_list : Rectangle {
                                        height: 44px;
                                        border-radius: 6px;
                                        background: gpu.id == root.selected_gpu_id ? #FF33441f : #ffffff08;
                                        border-width: 1px;
                                        border-color: gpu.id == root.selected_gpu_id ? #FF334488 : #ffffff14;

                                        TouchArea { clicked => { root.select_gpu_preference(gpu.id, gpu.name); } }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: center;
                                                Rectangle {
                                                    border-radius: 4px;
                                                    background: gpu.is_discrete ? #FF334426 : #ffffff14;
                                                    border-width: 1px;
                                                    border-color: gpu.is_discrete ? #FF334466 : #ffffff20;
                                                    HorizontalLayout {
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        padding-top: 3px;
                                                        padding-bottom: 3px;
                                                        Text {
                                                            text: gpu.is_discrete ? "Discrete" : "Integrated";
                                                            font-size: 11px;
                                                            font-weight: 700;
                                                            color: gpu.is_discrete ? #FF3344 : #A0A5B5;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: gpu.name;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    color: #FFFFFF;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            Rectangle {
                                                width: 18px;
                                                height: 18px;
                                                border-radius: 9px;
                                                background: gpu.id == root.selected_gpu_id ? #FF3344 : transparent;
                                                border-width: 2px;
                                                border-color: gpu.id == root.selected_gpu_id ? #FF3344 : #6B7280;
                                                y: 13px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ----------------------------------------------------
                    // SUB-TAB 2: WINDOW & GENERAL
                    // ----------------------------------------------------
                    if root.settings_tab_index == 2 : VerticalLayout {
                        spacing: 16px;

                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 16px;

                                Text {
                                    text: "GAME WINDOW RESOLUTION";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "Configure the initial window dimensions when Minecraft launches.";
                                    font-size: 12px;
                                    color: #A0A5B5;
                                }

                                // Quick Resolution Presets
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Resolution Presets:";
                                        font-size: 12px;
                                        color: #FFFFFF;
                                        vertical-alignment: center;
                                    }

                                    ActionButton {
                                        width: 110px;
                                        height: 32px;
                                        text: "720p (HD)";
                                        is_primary: root.window_width == 1280 && root.window_height == 720;
                                        clicked => { root.window_width = 1280; root.window_height = 720; }
                                    }
                                    ActionButton {
                                        width: 110px;
                                        height: 32px;
                                        text: "900p (HD+)";
                                        is_primary: root.window_width == 1600 && root.window_height == 900;
                                        clicked => { root.window_width = 1600; root.window_height = 900; }
                                    }
                                    ActionButton {
                                        width: 110px;
                                        height: 32px;
                                        text: "1080p (FHD)";
                                        is_primary: root.window_width == 1920 && root.window_height == 1080;
                                        clicked => { root.window_width = 1920; root.window_height = 1080; }
                                    }
                                    ActionButton {
                                        width: 110px;
                                        height: 32px;
                                        text: "1440p (2K)";
                                        is_primary: root.window_width == 2560 && root.window_height == 1440;
                                        clicked => { root.window_width = 2560; root.window_height = 1440; }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 20px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Window Width (pixels)"; font-size: 12px; color: #FFFFFF; font-weight: 600; }
                                        LineEdit {
                                            text: "" + root.window_width;
                                            edited(val) => { root.window_width = val.to-float(); }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Window Height (pixels)"; font-size: 12px; color: #FFFFFF; font-weight: 600; }
                                        LineEdit {
                                            text: "" + root.window_height;
                                            edited(val) => { root.window_height = val.to-float(); }
                                        }
                                    }
                                }
                            }
                        }

                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 14px;

                                Text {
                                    text: "INTEGRATIONS & DISCORD";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                CheckBox {
                                    text: "Enable Discord Rich Presence (Displays Minecraft status and instance name on Discord)";
                                    checked: root.enable_discord_rpc;
                                    toggled => { root.enable_discord_rpc = self.checked; }
                                }
                            }
                        }
                    }

                    // ----------------------------------------------------
                    // SUB-TAB 3: FOLDERS & STORAGE
                    // ----------------------------------------------------
                    if root.settings_tab_index == 3 : VerticalLayout {
                        spacing: 16px;

                        GlassCard {
                            VerticalLayout {
                                padding: 20px;
                                spacing: 16px;

                                Text {
                                    text: "STORAGE & DIRECTORY MANAGEMENT";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #FF3344;
                                    letter-spacing: 1px;
                                }

                                Text {
                                    text: "Customize where Minecraft game files, assets, and instances are saved on your computer.";
                                    font-size: 12px;
                                    color: #A0A5B5;
                                }

                                // Root Directory
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Launcher Root Directory (Assets, Caches, Libraries)"; font-size: 12px; color: #FFFFFF; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: root.launcher_root_dir_input;
                                            edited(val) => { root.launcher_root_dir_input = val; }
                                        }
                                        ActionButton {
                                            width: 100px;
                                            text: "Browse...";
                                            is_primary: false;
                                            clicked => { root.browse_root_dir_clicked(); }
                                        }
                                        ActionButton {
                                            width: 90px;
                                            text: "↗ Open";
                                            is_primary: false;
                                            clicked => { root.open_root_dir_clicked(); }
                                        }
                                    }
                                }

                                // Profiles Directory
                                VerticalLayout {
                                    spacing: 6px;
                                    Text { text: "Game Profiles Directory (Saves, Mods, Instances)"; font-size: 12px; color: #FFFFFF; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        LineEdit {
                                            horizontal-stretch: 1;
                                            text: root.profiles_dir_input;
                                            edited(val) => { root.profiles_dir_input = val; }
                                        }
                                        ActionButton {
                                            width: 100px;
                                            text: "Browse...";
                                            is_primary: false;
                                            clicked => { root.browse_profiles_dir_clicked(); }
                                        }
                                        ActionButton {
                                            width: 90px;
                                            text: "↗ Open";
                                            is_primary: false;
                                            clicked => { root.open_profiles_dir_clicked(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------
            // TAB 6: GAME CONSOLE / LOGS
            // ------------------------------------------
            if root.active_tab == 6 : VerticalLayout {
                padding: 24px;
                spacing: 20px;

                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "Game Console / Logs";
                            font-size: 26px;
                            font-weight: 900;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Real-time game runtime output and debug traces";
                            font-size: 13px;
                            color: #A0A5B5;
                        }
                    }

                    ActionButton {
                        width: 110px;
                        text: "Clear Logs";
                        is_primary: false;
                        clicked => { root.clear_console_clicked(); }
                    }
                }

                GlassCard {
                    vertical-stretch: 1;
                    background: #08090D;
                    border-color: #ffffff14;

                    ScrollView {
                        VerticalLayout {
                            padding: 16px;
                            Text {
                                text: root.console_output;
                                font-family: "JetBrains Mono, 'Fira Code', monospace";
                                font-size: 12px;
                                color: #D1D5DB;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
